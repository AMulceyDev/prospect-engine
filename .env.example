# Copy this file to .env and fill in the values before running docker compose up.

# ── SearXNG ─────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -hex 32
SEARXNG_SECRET=change-me-with-openssl-rand-hex-32

# ── INSEE API ────────────────────────────────────────────────────────────────
# Get your key at: https://portail-api.insee.fr/
INSEE_API_KEY=

# ── INPI / Registre National des Entreprises ─────────────────────────────────
# Register at: https://registre-national-entreprises.inpi.fr/
INPI_USERNAME=
INPI_PASSWORD=

# ── Ollama model ─────────────────────────────────────────────────────────────
# Default: llama3.2  (pulled automatically on first start)
# OLLAMA_MODEL=llama3.2

# ── LLM toggle ───────────────────────────────────────────────────────────────
# Set to false to skip all LLM calls (forces ownership=true, runs wayback + tech stack only)
# USE_LLM=false
